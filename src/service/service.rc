#include <winver.h>
#include "version.h"

1 ICON "win-infinit-desktop.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION WID_VERSION_RC
PRODUCTVERSION WID_VERSION_RC
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "WIN Infinit Desktop contributors"
            VALUE "FileDescription", "WIN Infinit Desktop"
            VALUE "FileVersion", WID_VERSION_RC_STRING
            VALUE "InternalName", "win-infinit-desktop"
            VALUE "LegalCopyright", "GPL-3.0-or-later"
            VALUE "OriginalFilename", "win-infinit-desktop.exe"
            VALUE "ProductName", "WIN Infinit Desktop"
            VALUE "ProductVersion", WID_VERSION_RC_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

#include <winver.h>

1 ICON "@WID_ICON_FILE@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @WID_VERSION_RC@
PRODUCTVERSION @WID_VERSION_RC@
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "WIN Infinit Desktop contributors"
            VALUE "FileDescription", "@WID_RC_DESCRIPTION@"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "@WID_RC_NAME@"
            VALUE "LegalCopyright", "GPL-3.0-or-later"
            VALUE "OriginalFilename", "@WID_RC_NAME@.exe"
            VALUE "ProductName", "WIN Infinit Desktop"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
